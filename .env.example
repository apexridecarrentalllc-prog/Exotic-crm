# Database
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/ie-manager?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Company Branding
NEXT_PUBLIC_COMPANY_NAME=EXOTIC
NEXT_PUBLIC_COMPANY_TAGLINE=LOGISTICS
NEXT_PUBLIC_INVOICE_TERMS=This is a computer-generated invoice. Please include the invoice number on your payment.

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourcompany.com
